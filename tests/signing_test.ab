import "../src/s3.ab"
import "abla/io"
import "../src/signing.ab"
import "abla/bytes"
import "../src/config.ab"

fun s3SigningTestConfig(): S3Config = S3Config(
    "s3.amazonaws.com", 443, "examplebucket", "us-east-1",
    "AKIAIOSFODNN7EXAMPLE",
    "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
    "", false, true, 30000, 1048576, 0
)

fun signingRejected(result: S3SigningResult, code: string): bool =
    when (result) {
        is S3SigningRejected -> result.error == code
        is S3Signed -> false
    }

fun main: int {
    if (s3UnixToAmzDate(0) != "19700101T000000Z") return 1
    if (s3UnixToAmzDate(1369353600) != "20130524T000000Z") return 2
    if (s3UriEncode("test${byteEncode(36)}file.text") != "test%24file.text") return 3
    if (s3UriEncode("a/b c", true) != "a/b%20c") return 4
    if (!s3KeyValid("users/ada/file.txt") || s3KeyValid("../secret") ||
        s3KeyValid("a//b") || s3KeyValid("/absolute")) return 5
    val signed = s3SignRequest(
        s3SigningTestConfig(), "GET", "/test.txt", "", "",
        "20130524T000000Z", [S3Header("Range", "bytes=0-9")]
    )
    if (!signed.succeeded) return 6
    val emptyHash =
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    val expectedCanonical = "GET\n/test.txt\n\nhost:examplebucket.s3.amazonaws.com\nrange:bytes=0-9\nx-amz-content-sha256:$emptyHash\nx-amz-date:20130524T000000Z\n\nhost;range;x-amz-content-sha256;x-amz-date\n$emptyHash"
    if (signed.canonicalRequest != expectedCanonical) return 7
    if (signed.signature !=
        "f0e8bdb87c964420e857bd35b5d6ed310bd44f0170aba48dd91039c6036bdb41") {
        println("unexpected AWS reference signature: ${signed.signature}")
        return 8
    }
    if (signed.signedHeaders !=
        "host;range;x-amz-content-sha256;x-amz-date") return 9
    if (signed.authorization.slice(0, 16) != "AWS4-HMAC-SHA256") return 10
    val duplicate = s3SignRequest(
        s3SigningTestConfig(), "GET", "/test.txt", "", "",
        "20130524T000000Z", [S3Header("Host", "evil.example")]
    )
    if (duplicate.succeeded || duplicate.error != "invalid_header") return 11

    val config = s3SigningTestConfig()
    val date = "20130524T000000Z"
    val typed = s3SignRequestResult(
        config, "GET", "/test.txt", "", "", date, [S3Header("Range", "bytes=0-9")]
    )
    when (typed) {
        is S3SigningRejected -> return 12
        is S3Signed -> {
            if (typed.canonicalRequest != expectedCanonical || typed.signature != signed.signature ||
                typed.authorization != signed.authorization || typed.stringToSign != signed.stringToSign ||
                typed.signedHeaders != signed.signedHeaders || typed.headers.size != signed.headers.size)
                return 13
            var index = 0
            while (index < typed.headers.size) {
                if (typed.headers[index].name != signed.headers[index].name ||
                    typed.headers[index].value != signed.headers[index].value) return 14
                index = index + 1
            }
        }
    }

    val invalidConfig = S3Config("", 443, "examplebucket", "us-east-1",
        "access-key", "secret-key", "", false, true, 30000, 1048576, 0)
    if (!signingRejected(s3SignRequestResult(invalidConfig, "GET", "/", "", "", date),
            "invalid_configuration")) return 15
    if (!signingRejected(s3SignRequestResult(config, "PATCH", "/", "", "", date),
            "invalid_method")) return 16
    if (!signingRejected(s3SignRequestResult(config, "GET", "test.txt", "", "", date),
            "invalid_request")) return 17
    if (!signingRejected(s3SignRequestResult(
        config, "GET", "/", "", "", date, [S3Header("Host", "evil.example")]
    ), "invalid_header")) return 18

    val query = s3CanonicalQuery(["uploadId", "partNumber"], ["a/b", "2"])
    val unsignedSignature = "d5b65d285ce6c34055b4ca8c33c1027daa70f56dd8ed4c211eebccd8786a51dc"
    if (s3SignRequest(config, "PUT", "/test.txt", query, "", date, [],
            "UNSIGNED-PAYLOAD").signature != unsignedSignature) return 19
    val typedUnsigned = s3SignRequestResult(
        config, "PUT", "/test.txt", query, "", date, [], "UNSIGNED-PAYLOAD"
    )
    when (typedUnsigned) {
        is S3SigningRejected -> return 20
        is S3Signed -> if (typedUnsigned.signature != unsignedSignature) return 21
    }
    0
}
